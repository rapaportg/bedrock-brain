# =============================================================================
# bedrock-brain — DigitalOcean production environment
# Copy to /opt/bedrock-brain/.env and fill in real values
# =============================================================================

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Public domains (must match DNS A records + nginx.conf) ---
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
AUTH_DOMAIN=auth.yourdomain.com
MCP_DOMAIN=mcp.yourdomain.com
KEYCLOAK_PUBLIC_HOST=auth.yourdomain.com

# --- Let's Encrypt ---
CERTBOT_EMAIL=you@yourdomain.com

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bedrock
POSTGRES_USER=bedrock
POSTGRES_PASSWORD=changeme-strong-password

# --- PgBouncer ---
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage: DigitalOcean Spaces (S3-compatible) ---
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=your-spaces-access-key
S3_SECRET_ACCESS_KEY=your-spaces-secret-key
S3_BUCKET_NAME=bedrock-brain
S3_REGION=nyc3

# --- Auth (Keycloak) ---
OIDC_ISSUER_URL=https://auth.yourdomain.com/realms/bedrock
OIDC_JWKS_URL=https://auth.yourdomain.com/realms/bedrock/protocol/openid-connect/certs
OIDC_AUDIENCE=brain-api

# --- Brain API ---
BRAIN_API_URL=http://brain-api:8000
SECRET_KEY=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- MCP Gateway ---
MCP_GATEWAY_PORT=8001
MCP_BRAIN_API_URL=http://brain-api:8000

# --- Sync Bridge ---
SYNC_VAULT_PATH=/vault
SYNC_API_URL=http://brain-api:8000
SYNC_AGENT_TOKEN=generate-with-openssl-rand-hex-32
SYNC_POLL_INTERVAL_SECONDS=5

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-strong-password
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=bedrock
KC_DB_PASSWORD=changeme-strong-password
