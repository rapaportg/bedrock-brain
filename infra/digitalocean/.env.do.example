# =============================================================================
# bedrock-brain — DigitalOcean production environment
#
# Copy to /opt/bedrock-brain/.env on the Droplet and fill in your values
# before running deploy.sh for the first time.
#
# DNS: Create A records pointing each domain to your Droplet IP.
# =============================================================================

# ---------------------------------------------------------------------------
# Domains — used by nginx and the deploy/cert scripts
# ---------------------------------------------------------------------------
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
AUTH_DOMAIN=auth.yourdomain.com
MCP_DOMAIN=mcp.yourdomain.com

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=bedrock
POSTGRES_USER=bedrock
POSTGRES_PASSWORD=change_me_use_strong_password

# ---------------------------------------------------------------------------
# PgBouncer
# ---------------------------------------------------------------------------
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20

# ---------------------------------------------------------------------------
# DigitalOcean Spaces (S3-compatible object storage)
# Create a Space and a Spaces access key in the DO control panel.
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=your_spaces_access_key_id
S3_SECRET_ACCESS_KEY=your_spaces_secret_key
S3_BUCKET_NAME=bedrock-brain
S3_REGION=nyc3

# ---------------------------------------------------------------------------
# App secret — used to sign internal tokens; use `openssl rand -hex 32`
# ---------------------------------------------------------------------------
SECRET_KEY=change_me_use_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Keycloak — OIDC provider
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
KEYCLOAK_PUBLIC_HOST=auth.yourdomain.com    # must match AUTH_DOMAIN

# ---------------------------------------------------------------------------
# OIDC — points at Keycloak above
# ---------------------------------------------------------------------------
OIDC_ISSUER_URL=https://auth.yourdomain.com/realms/bedrock
OIDC_JWKS_URL=https://auth.yourdomain.com/realms/bedrock/protocol/openid-connect/certs
OIDC_AUDIENCE=brain-api

# ---------------------------------------------------------------------------
# Let's Encrypt — email for cert expiry notifications
# ---------------------------------------------------------------------------
CERTBOT_EMAIL=admin@yourdomain.com
