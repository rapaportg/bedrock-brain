# =============================================================================
# bedrock-brain — environment variables
# Copy to .env and fill in values before running docker-compose
# =============================================================================

# --- Postgres (NCI VM in prod, local container in dev) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bedrock
POSTGRES_USER=bedrock
POSTGRES_PASSWORD=changeme

# --- PgBouncer ---
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object Storage (MinIO locally, Nutanix Objects in prod) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=bedrock-brain
S3_REGION=us-east-1

# --- Auth (Keycloak locally, Okta in prod) ---
OIDC_ISSUER_URL=http://keycloak:8080/realms/bedrock
OIDC_JWKS_URL=http://keycloak:8080/realms/bedrock/protocol/openid-connect/certs
OIDC_AUDIENCE=brain-api

# --- Brain API ---
BRAIN_API_URL=http://brain-api:8000
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- MCP Gateway ---
MCP_GATEWAY_PORT=8001
MCP_BRAIN_API_URL=http://brain-api:8000

# --- Sync Bridge ---
SYNC_VAULT_PATH=/vault
SYNC_API_URL=http://brain-api:8000
SYNC_AGENT_TOKEN=sync-bridge-dev-token
SYNC_POLL_INTERVAL_SECONDS=5

# --- Keycloak (dev only) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=bedrock
KC_DB_PASSWORD=changeme
