# Keycloak / OIDC
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bedrock
VITE_KEYCLOAK_CLIENT_ID=brain-ui

# Brain API base URL.
# Leave EMPTY during `make web-dev` — the Vite proxy rewrites /api → /v1 on localhost:8000.
# Set to the brain-api origin (e.g. http://localhost:8000) for standalone builds
# where no proxy is available (Docker, staging, prod).
VITE_API_BASE_URL=
